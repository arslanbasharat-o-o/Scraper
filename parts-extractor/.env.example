# Parts Extractor — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.

# ── Application ──────────────────────────────────────────────────────────────
# Required in production: a random 32+ character string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Flask debug mode (0 = off, 1 = on — NEVER enable in production)
FLASK_DEBUG=0

# ── Authentication ────────────────────────────────────────────────────────────
# When NOT set, the app is accessible without login (backward-compatible mode).
# Set both AUTH_USERNAME and either AUTH_PASSWORD_HASH (production) or
# AUTH_PASSWORD (development only) to enable authentication.

AUTH_USERNAME=admin
AUTH_ROLE=admin

# PRODUCTION: Hashed password (recommended). Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
# AUTH_PASSWORD_HASH=pbkdf2:sha256:...

# DEVELOPMENT ONLY: Plaintext password (a warning is logged, use AUTH_PASSWORD_HASH in production)
# AUTH_PASSWORD=changeme

# Session lifetime in hours (default: 8)
AUTH_SESSION_HOURS=8

# Set to 0 to disable auth entirely even if credentials are configured
# AUTH_ENABLED=1

# ── Scraper ───────────────────────────────────────────────────────────────────
# Use browser automation as fallback when HTTP cannot retrieve supplier data.
# 0 = HTTP-only, 1 = browser fallback enabled (default: 0 — HTTP-first)
SCRAPER_USE_BROWSER=0

# Maximum concurrent browser windows for fallback scraping (1–4)
SCRAPER_LOCAL_BROWSER_MAX_WINDOWS=1

# Anomaly guard: detect suspiciously sparse scrape results (1 = enabled)
SCRAPER_ANOMALY_GUARD=1

# Baseline protection: block saves when current run is much smaller than previous (1 = enabled)
SCRAPER_BASELINE_PROTECTION=1

# Number of history records to keep per URL set (0 = unlimited)
SCRAPER_HISTORY_KEEP_PER_URL_SET=2

# ── Database ──────────────────────────────────────────────────────────────────
# Default: data/site_dbs/ (SQLite). No configuration required for single-user deployment.
# DATA_DIR=data

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Poll interval for the in-process automation scheduler (seconds, default: 45)
AUTOMATION_POLL_INTERVAL_SECONDS=45

# IMPORTANT: Run with --workers 1 when using the in-process scheduler:
#   gunicorn -w 1 -b 0.0.0.0:5000 app:app
# Multiple Gunicorn workers will create duplicate scheduler threads.

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Leave empty when not using a tunnel. When set, the tunnel URL is shown in logs.
# CLOUDFLARED_TUNNEL_URL=

# ── Concurrency ───────────────────────────────────────────────────────────────
XCELL_MAX_WORKERS=16

# ── Content / Upload ──────────────────────────────────────────────────────────
MAX_REQUEST_SIZE_MB=25
