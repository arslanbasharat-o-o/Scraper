# ===============================================================================
# Parts Extractor — Production Server Profile (40 GB VPS / Hostinger)
# ===============================================================================
# Copy this file to .env when deploying to a 40 GB RAM Linux server.
# Run 'bash deploy.sh' to install Python dependencies and check deployment readiness.
# ===============================================================================

# -- 1. Application Core & Security -------------------------------------------
# Required in production: generate a 32+ character random secret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

FLASK_DEBUG=0
PORT=5000
MAX_REQUEST_SIZE_MB=25

# -- 2. Hardware Profile & Global Concurrency ---------------------------------
SCRAPER_WORKER_PROFILE=server_40gb
SCRAPER_WORKER_HARD_CAP=160

# -- 3. Phase 1 Worker Concurrency (Category Crawlers) -------------------------
SCRAPER_STANDARD_PHASE1_WORKERS=48
SCRAPER_XCELL_PHASE1_WORKERS=48
SCRAPER_TXPARTS_PHASE1_WORKERS=40
SCRAPER_PARTS4CELLS_PHASE1_WORKERS=40
SCRAPER_PHONELCDPARTS_PHASE1_WORKERS=40
SCRAPER_GADGETFIX_PHASE1_WORKERS=32

# -- 4. Phase 2 Worker Concurrency (Product SKU & Detail Enrichment) ----------
SCRAPER_STANDARD_DETAIL_WORKERS=48
SCRAPER_XCELL_DETAIL_WORKERS=96
SCRAPER_TXPARTS_DETAIL_WORKERS=64
SCRAPER_PARTS4CELLS_DETAIL_WORKERS=64
SCRAPER_PHONELCDPARTS_DETAIL_WORKERS=80
SCRAPER_GADGETFIX_DETAIL_WORKERS=64
SCRAPER_MOBILESENTRIX_CANADA_DETAIL_WORKERS=32

SCRAPER_DEFAULT_DELAY_MS=0
SCRAPER_DETAIL_HTTP_TIMEOUT=12

# -- 5. Proxy Configuration ----------------------------------------------------
# Keep SCRAPER_PROXY_URL unset for normal direct traffic.
# Optional residential proxy is used only after direct tactics fail, and only
# for Menu Map jobs plus MobileSentrix/PhoneLCDParts product or category fetches.
# URL-encode reserved characters in the username/password when required.
# SCRAPER_LAST_RESORT_PROXY_URL=http://username:password@residential-proxy.example:1080

# -- 6. Browser Automation & Botasaurus ---------------------------------------
SCRAPER_LOCAL_BROWSER_FALLBACK=1
SCRAPER_LOCAL_BROWSER_MAX_WINDOWS=4
SCRAPER_LOCAL_BROWSER_HEADLESS=1

# Keep HTTP fast-path primary (0 = disabled, 1 = enabled)
SCRAPER_DETAIL_BROWSER_BATCH=0
SCRAPER_BOTASAURUS_BATCH_SIZE=112
SCRAPER_DETAIL_BROWSER_TIMEOUT=18

# After HTTP fails, let Scrapling's stealth browser attempt Cloudflare recovery.
# The 60 second floor gives the solver time; Botasaurus remains the final fallback.
SCRAPER_SCRAPLING_ENABLED=1
SCRAPER_SCRAPLING_SOLVE_CLOUDFLARE=1
SCRAPER_SCRAPLING_STEALTH_TIMEOUT=60

# CRITICAL: Always keep set to 0 on headless servers to prevent infinite loops
SCRAPER_BOTASAURUS_BYPASS_CLOUDFLARE=0

# Primary browser engines (keep empty so curl_cffi Safari is primary)
SCRAPER_BOTARUS_PRIMARY_ENGINES=

# Chrome binary path on Ubuntu (install Chrome separately if needed)
SCRAPER_CHROME_PATH=/usr/bin/google-chrome

# -- 7. Safety, Quality Guards & History --------------------------------------
SCRAPER_ANOMALY_GUARD=1
SCRAPER_BASELINE_PROTECTION=1
SCRAPER_HISTORY_KEEP_PER_URL_SET=2
AUTOMATION_POLL_INTERVAL_SECONDS=45
