# Parts Extractor — Windows laptop profile
# Copy this to .env, or run start.bat to initialize the local Windows setup.

SECRET_KEY=
FLASK_DEBUG=0
PORT=5000
MAX_REQUEST_SIZE_MB=25

# Conservative profile for a Windows laptop with approximately 8–10 GB RAM.
SCRAPER_WORKER_PROFILE=local_10gb
SCRAPER_WORKER_HARD_CAP=32

# Keep supplier traffic moderate on a VPN/laptop connection.
SCRAPER_STANDARD_PHASE1_WORKERS=8
SCRAPER_XCELL_PHASE1_WORKERS=8
SCRAPER_TXPARTS_PHASE1_WORKERS=8
SCRAPER_PARTS4CELLS_PHASE1_WORKERS=8
SCRAPER_PHONELCDPARTS_PHASE1_WORKERS=8
SCRAPER_GADGETFIX_PHASE1_WORKERS=6

SCRAPER_STANDARD_DETAIL_WORKERS=12
SCRAPER_XCELL_DETAIL_WORKERS=12
SCRAPER_TXPARTS_DETAIL_WORKERS=10
SCRAPER_PARTS4CELLS_DETAIL_WORKERS=10
SCRAPER_PHONELCDPARTS_DETAIL_WORKERS=10
SCRAPER_GADGETFIX_DETAIL_WORKERS=8
SCRAPER_MOBILESENTRIX_CANADA_DETAIL_WORKERS=8

# Small pacing delay avoids saturating the VPN and keeps the laptop responsive.
SCRAPER_DEFAULT_DELAY_MS=150
SCRAPER_DETAIL_HTTP_TIMEOUT=20

# Use the local browser only as a bounded fallback.
SCRAPER_LOCAL_BROWSER_FALLBACK=1
SCRAPER_LOCAL_BROWSER_MAX_WINDOWS=1
SCRAPER_LOCAL_BROWSER_HEADLESS=1
SCRAPER_DETAIL_BROWSER_BATCH=0
SCRAPER_BOTASAURUS_BATCH_SIZE=24
SCRAPER_DETAIL_BROWSER_TIMEOUT=25
SCRAPER_LOCAL_BROWSER_WAIT_SECONDS=0.5
SCRAPER_LOCAL_BROWSER_CHALLENGE_WAIT_SECONDS=30
SCRAPER_BOTASAURUS_BYPASS_CLOUDFLARE=0

# Leave empty unless you intentionally configure an approved proxy.
# SCRAPER_PROXY_URL=http://user:password@host:port

SCRAPER_ANOMALY_GUARD=1
SCRAPER_BASELINE_PROTECTION=1
SCRAPER_HISTORY_KEEP_PER_URL_SET=2
MAX_PROXIED_IMAGE_MB=5
AUTOMATION_POLL_INTERVAL_SECONDS=45
DATABASES_DIR=data/site_dbs
