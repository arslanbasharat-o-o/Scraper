# ===============================================================================
# Parts Extractor — Authoritative Environment Configuration Reference
# ===============================================================================
# Copy this file to .env and tune for your environment.
# NEVER commit your actual .env file to version control.
#
# Supported Workstation / Server Profiles:
#   - 10 GB RAM Workstation: SCRAPER_WORKER_PROFILE=local_10gb
#   - 40 GB RAM Server:      SCRAPER_WORKER_PROFILE=server_40gb
# ===============================================================================

# -- 1. Application Core & Security -------------------------------------------
# Required in production: a random 32+ character string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Flask debug mode (0 = off, 1 = on -- NEVER enable in production)
FLASK_DEBUG=0

# Server bind port (default: 5000)
PORT=5000

# Maximum incoming request payload size in megabytes (default: 25)
MAX_REQUEST_SIZE_MB=25

# Optional public base URL for sitemap and reverse-proxy setups
# PUBLIC_BASE_URL=https://scraper.example.com

# Allowed origins for CORS (comma-separated, empty = allow same-origin)
# CORS_ALLOWED_ORIGINS=https://scraper.example.com

# -- 2. Authentication --------------------------------------------------------
# When NOT set, the app runs in backward-compatible single-user mode.
# In production, set AUTH_USERNAME, AUTH_ROLE, and AUTH_PASSWORD_HASH.
AUTH_USERNAME=admin
AUTH_ROLE=admin

# PRODUCTION: Hashed password. Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
# AUTH_PASSWORD_HASH=pbkdf2:sha256:...

# DEVELOPMENT ONLY: Plaintext password (generates a security warning)
# AUTH_PASSWORD=changeme

# Session lifetime in hours (default: 8)
AUTH_SESSION_HOURS=8

# -- 3. Performance & Memory Profile -----------------------------------------
# Choose your hardware memory profile:
#   local_10gb   -> 10 GB RAM machines (64 worker hard cap, 1 browser window)
#   server_40gb  -> 40 GB RAM servers (160 worker hard cap, 4-8 browser windows)
# Leave blank to use conservative built-in defaults.
SCRAPER_WORKER_PROFILE=server_40gb

# Optional global hard ceiling for concurrent thread workers (1-256)
# Default: 64 for local_10gb, 160 for server_40gb
# SCRAPER_WORKER_HARD_CAP=160

# -- 4. Scraper Concurrency (Supplier Worker Tuning) --------------------------
# Fine-tune phase-1 (category/search listings) and phase-2 (detail enrichment)
# worker threads per supplier. If unset, values are derived from SCRAPER_WORKER_PROFILE.
#
# Baseline Recommendations for 40 GB Server:
# Phase 1: Category Crawlers
SCRAPER_STANDARD_PHASE1_WORKERS=48
SCRAPER_XCELL_PHASE1_WORKERS=48
SCRAPER_TXPARTS_PHASE1_WORKERS=40
SCRAPER_PARTS4CELLS_PHASE1_WORKERS=40
SCRAPER_PHONELCDPARTS_PHASE1_WORKERS=40
SCRAPER_GADGETFIX_PHASE1_WORKERS=32

# Phase 2: Product SKU & Detail Enrichment (HTTP Fast-Path)
SCRAPER_STANDARD_DETAIL_WORKERS=48
SCRAPER_XCELL_DETAIL_WORKERS=96
SCRAPER_TXPARTS_DETAIL_WORKERS=64
SCRAPER_PARTS4CELLS_DETAIL_WORKERS=64
SCRAPER_PHONELCDPARTS_DETAIL_WORKERS=80
SCRAPER_GADGETFIX_DETAIL_WORKERS=64
SCRAPER_MOBILESENTRIX_CANADA_DETAIL_WORKERS=32

# -- 5. HTTP Client, Networking & Timeouts -------------------------------------
# Product detail HTTP request timeout in seconds (default: 12)
SCRAPER_DETAIL_HTTP_TIMEOUT=12

# Optional Egress Proxy (HTTP/HTTPS/SOCKS5)
# Use when running on datacenter IPs (e.g. Hostinger, AWS) that encounter
# Cloudflare Turnstile / 403 blocks on supplier sites.
# Applies to both curl_cffi HTTP requests and Botasaurus browser automation.
# SCRAPER_PROXY_URL=http://user:pass@proxy-server:port
# HTTPS_PROXY=http://user:pass@proxy-server:port
# HTTP_PROXY=http://user:pass@proxy-server:port

# -- 6. Browser Automation & Botasaurus Fallback ------------------------------
# Keep HTTP requests primary; retry blocked or SKU-less detail pages
# with the bounded local browser fallback. (0 = off, 1 = on, default: 1)
SCRAPER_LOCAL_BROWSER_FALLBACK=1

# Maximum concurrent browser windows for fallback scraping:
#   local_10gb recommendation: 1 window
#   server_40gb recommendation: 4 to 8 windows
SCRAPER_LOCAL_BROWSER_MAX_WINDOWS=4

# Run browser in headless mode (1 = headless, 0 = visible browser, default: 1)
SCRAPER_LOCAL_BROWSER_HEADLESS=1

# Compact batched Botasaurus retry lane for blocked MobileSentrix detail pages
# Enables processing many URLs per warmed browser session without returning full DOM.
SCRAPER_DETAIL_BROWSER_BATCH=1
SCRAPER_BOTASAURUS_BATCH_SIZE=112
SCRAPER_DETAIL_BROWSER_TIMEOUT=18

# Delay after page navigation in browser fallback (seconds, default: 0.3)
SCRAPER_LOCAL_BROWSER_WAIT_SECONDS=0.3

# Seconds to wait for Cloudflare challenge completion in browser (default: 15)
SCRAPER_LOCAL_BROWSER_CHALLENGE_WAIT_SECONDS=15

# Cloudflare Turnstile auto-solver loop (0 = off, 1 = on).
# CRITICAL: Keep set to 0 in headless server mode to prevent hanging loops on datacenter IPs.
SCRAPER_BOTASAURUS_BYPASS_CLOUDFLARE=0

# Explicit Chrome executable path (auto-discovered if unset)
# CHROME_BIN=/usr/bin/google-chrome
# SCRAPER_CHROME_PROFILE_ROOT=/var/www/html/Scraper/data/browser_profiles

# -- 7. Data Safety, Guards & History -----------------------------------------
# Anomaly guard: detect suspiciously sparse scrape results (1 = enabled)
SCRAPER_ANOMALY_GUARD=1

# Baseline protection: block saves when current run is much smaller than previous (1 = enabled)
SCRAPER_BASELINE_PROTECTION=1

# Number of historical snapshots to keep per URL set (0 = unlimited, default: 2)
SCRAPER_HISTORY_KEEP_PER_URL_SET=2

# Maximum size in megabytes for proxied product images (default: 5)
MAX_PROXIED_IMAGE_MB=5

# -- 8. Automation & Storage --------------------------------------------------
# In-process automation scheduler poll interval in seconds (default: 45)
AUTOMATION_POLL_INTERVAL_SECONDS=45

# Database directory (default: data/site_dbs/ with SQLite in WAL mode)
# DATABASES_DIR=data/site_dbs
